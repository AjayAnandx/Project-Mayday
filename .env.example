# Mayday — Environment Variables
# Copy this file to .env and fill in your keys before starting the service.
# .env is already in .gitignore — it will not be committed.

# Deepgram API key — required for voice TTS
# Get one at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# GitHub Personal Access Token — required for github-mcp-server tools
# Create at https://github.com/settings/tokens (needs repo + contents scopes)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Exa AI Search API key — required for web search tools
# Get at https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Optional — override the Ollama endpoint
# OLLAMA_ENDPOINT=http://localhost:11434/v1/chat/completions

# LLM gateway — OpenAI (default worker) + OpenRouter + Ollama Cloud fallback
# Get an OpenAI key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# Optional — override the OpenAI model (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Optional — override the Realtime voice model (default gpt-realtime-2.1)
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Get an OpenRouter key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Optional — override the OpenRouter model slug (default nvidia/nemotron-3-super-120b-a12b:free)
# OPENROUTER_MODEL=openai/gpt-5-mini
# Ollama Cloud key (https://ollama.com → Settings → API Keys)
# OLLAMA_API_KEY=
# Optional — override the Ollama Cloud model
# OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud

# Optional — override the projects directory
# PROJECTS_DIR=

# Gmail OAuth — dedicated consumer mailbox (local-only)
# Credentials file lives at backend/credentials/gmail_credentials.json (gitignored).
# Only set these to override config.yaml defaults:
# GOOGLE_CREDENTIALS_PATH=backend/credentials/gmail_credentials.json
# GMAIL_TOKEN_PATH_AGENT=tokens/agent_token.json
# GMAIL_TOKEN_PATH_USER=tokens/user_token.json
# GMAIL_AGENT_EMAIL=maydayishereatwork@gmail.com

# Telegram Bot — required for Mayday ↔ Telegram bridge
# Create a bot via @BotFather on Telegram, then paste the token:
TELEGRAM_BOT_TOKEN=
# Then set telegram.enabled=true and telegram.allowed_chat_ids=[your_chat_id] in config.yaml
# Get your chat_id by messaging the bot once and checking the backend logs or via @userinfobot
